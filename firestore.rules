rules_version = '2';

// Banco de respawns do Medivia Respawn.
// - Qualquer pessoa lê.
// - Para gravar é preciso a identidade anônima que o site cria no primeiro envio.
// - Quem enviou um respawn pode corrigi-lo ou apagá-lo.
// - Os demais só podem acrescentar monstros: não alteram nem removem o que já existe.
// - Ninguém grava nada fora do formato esperado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /respawns/{id} {
      function shape(d) {
        return d.keys().hasOnly(['name', 'monsters', 'cost10', 'duration', 'readAt', 'owner', 'at'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
          && d.monsters is map && d.monsters.size() >= 1 && d.monsters.size() <= 80
          && d.owner is string
          && d.at == request.time
          && (!('cost10' in d) || (d.cost10 is int && d.cost10 > 0 && d.cost10 <= 100000000))
          && (!('duration' in d) || (d.duration is int && d.duration >= 10 && d.duration <= 1000))
          && (!('readAt' in d) || (d.readAt is int && d.readAt >= 0 && d.readAt <= 100));
      }
      function kept(field) {
        return !(field in resource.data)
          || (field in request.resource.data && request.resource.data[field] == resource.data[field]);
      }

      allow read: if true;

      allow create: if request.auth != null
        && id.matches('^[a-z0-9-]{1,80}$')
        && shape(request.resource.data)
        && request.resource.data.owner == request.auth.uid;

      allow update: if request.auth != null
        && shape(request.resource.data)
        && request.resource.data.owner == resource.data.owner
        && (
          resource.data.owner == request.auth.uid
          || (
            request.resource.data.name == resource.data.name
            && request.resource.data.monsters.diff(resource.data.monsters).removedKeys().size() == 0
            && request.resource.data.monsters.diff(resource.data.monsters).changedKeys().size() == 0
            && kept('cost10')
            && kept('duration')
          )
        );

      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Salas de sorteio com dado D100.
    // - Qualquer pessoa lê (é assim que todos veem as jogadas).
    // - Quem cria a sala é o dono: só ele abre rodadas, dá nome aos itens e encerra a sala.
    // - Sala criada há mais de um dia pode ser apagada por qualquer pessoa: é assim que o número volta a ficar livre.
    // - Cada pessoa grava só a própria jogada, uma por rodada, com a hora do servidor. O valor do dado é
    //   calculado pelo site a partir dessa hora, então ninguém escolhe o resultado nem altera jogada alheia.
    match /rooms/{code} {
      function rollKey() {
        return string(resource.data.round) + '_' + request.auth.uid;
      }
      function added() {
        return request.resource.data.rolls.diff(resource.data.rolls);
      }

      allow read: if true;

      allow create: if request.auth != null
        && code.matches('^[0-9]{4,6}$')
        && request.resource.data.keys().hasOnly(['owner', 'at', 'round', 'items', 'rolls'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.round == 1
        && request.resource.data.items is map && request.resource.data.items.size() == 0
        && request.resource.data.rolls is map && request.resource.data.rolls.size() == 0;

      allow update: if request.auth != null
        && (
          (
            resource.data.owner == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['round', 'items'])
            && request.resource.data.round is int
            && (request.resource.data.round == resource.data.round || request.resource.data.round == resource.data.round + 1)
            && request.resource.data.round <= 200
            && request.resource.data.items is map && request.resource.data.items.size() <= 200
          ) || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rolls'])
            && added().addedKeys().hasOnly([rollKey()])
            && added().addedKeys().size() == 1
            && added().changedKeys().size() == 0
            && added().removedKeys().size() == 0
            && request.resource.data.rolls.size() <= 400
            && request.resource.data.rolls[rollKey()].keys().hasOnly(['name', 'at'])
            && request.resource.data.rolls[rollKey()].name is string
            && request.resource.data.rolls[rollKey()].name.size() >= 1
            && request.resource.data.rolls[rollKey()].name.size() <= 24
            && request.resource.data.rolls[rollKey()].at == request.time
          )
        );

      allow delete: if request.auth != null
        && (resource.data.owner == request.auth.uid || resource.data.at < request.time - duration.value(24, 'h'));
    }
  }
}
